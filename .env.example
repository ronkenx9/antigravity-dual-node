# ==============================================================================
# Dual-Node Configuration (.env)
# ==============================================================================

# Windows HP OMEN (Worker Node) Network Details
OMEN_HOST=omen.local
OMEN_LAN_IP=192.168.1.150
OMEN_TAILSCALE_IP=100.x.y.z
OMEN_MAC_ADDRESS=AA:BB:CC:DD:EE:FF
OMEN_SSH_PORT=22
OMEN_USER=hp

# SMB File Share Configuration
OMEN_SMB_SHARE=RenderQueue
OMEN_SMB_USER=hp
OMEN_SMB_PASSWORD=your_password_here
MAC_SMB_MOUNT_POINT=/Volumes/RenderQueue

# Local Compute Server Ports (Windows side)
COMFYUI_PORT=8188
OLLAMA_PORT=11434
SUNSHINE_PORT=47989
MOONLIGHT_PORT=47990

# Orchestrator Settings
NODE_ROLE=commander # commander (Mac) or worker (Windows OMEN)
TASK_POLL_INTERVAL_SEC=3
